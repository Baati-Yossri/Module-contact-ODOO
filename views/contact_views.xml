<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_contact_list" model="ir.ui.view">
        <field name="name">mon_module.contact.list</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <list string="Contacts">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_contact_form" model="ir.ui.view">
        <field name="name">mon_module.contact.form</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <form string="Contact">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="category_id"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Relations">
                            <field name="related_contact_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_contact" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">mon_module.contact</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contact_search"/>
    </record>

    <!-- ================= MENU ================= -->
    <menuitem id="menu_contact"
              name="Contacts"
              parent="menu_mon_module_root"
              action="action_contact"
              sequence="20"/>

</odoo>
