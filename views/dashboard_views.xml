<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- 1) KANBAN : Categories Dashboard                      -->
    <!-- ===================================================== -->
    <record id="view_category_kanban_dashboard" model="ir.ui.view">
        <field name="name">mon_module.category.kanban.dashboard</field>
        <field name="model">mon_module.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="description"/>
                <field name="color"/>
                <field name="active"/>
                <field name="contact_count"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <span class="badge bg-primary">
                                    <field name="contact_count"/> contacts
                                </span>
                            </div>

                            <div class="mt8 text-muted">
                                <field name="description"/>
                            </div>

                            <div class="mt8">
                                <t t-if="record.active.raw_value">
                                    <span class="badge bg-success">Active</span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-secondary">Archived</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dashboard_categories_kanban" model="ir.actions.act_window">
        <field name="name">Catégories (Dashboard)</field>
        <field name="res_model">mon_module.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_category_kanban_dashboard"/>
    </record>

    <!-- ===================================================== -->
    <!-- 2) GRAPH : Contacts per Category                      -->
    <!-- ===================================================== -->
    <record id="view_contacts_graph_by_category" model="ir.ui.view">
        <field name="name">mon_module.contact.graph.by.category</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <graph string="Nombre de contacts par catégorie" type="bar">
                <field name="category_id"/>
                <field name="id" type="measure" operator="count"/>
            </graph>
        </field>
    </record>

    <record id="action_dashboard_contacts_graph" model="ir.actions.act_window">
        <field name="name">Analyse (Graph)</field>
        <field name="res_model">mon_module.contact</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_contacts_graph_by_category"/>
        <field name="domain">[('active','=',True)]</field>
    </record>

    <!-- ===================================================== -->
    <!-- 3) PIVOT : Contact Statistics (AUTO COUNT)            -->
    <!-- ===================================================== -->
    <record id="view_contacts_pivot_by_category" model="ir.ui.view">
        <field name="name">mon_module.contact.pivot.by.category</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <pivot string="Statistiques des contacts">
                <field name="category_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_dashboard_contacts_pivot" model="ir.actions.act_window">
        <field name="name">Statistiques (Pivot)</field>
        <field name="res_model">mon_module.contact</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_contacts_pivot_by_category"/>
        <field name="domain">[('active','=',True)]</field>
    </record>

    <!-- ===================================================== -->
    <!-- 4) MENUS : Dashboard                                  -->
    <!-- ===================================================== -->

    <menuitem id="menu_dashboard_root"
              name="Dashboard"
              parent="menu_mon_module_root"
              sequence="30"/>

    <menuitem id="menu_dashboard_categories"
              name="Catégories (Kanban)"
              parent="menu_dashboard_root"
              action="action_dashboard_categories_kanban"
              sequence="10"/>

    <menuitem id="menu_dashboard_graph"
              name="Analyse (Graph)"
              parent="menu_dashboard_root"
              action="action_dashboard_contacts_graph"
              sequence="20"/>

    <menuitem id="menu_dashboard_pivot"
              name="Statistiques (Pivot)"
              parent="menu_dashboard_root"
              action="action_dashboard_contacts_pivot"
              sequence="30"/>

</odoo>
